<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CogtiveDevAssignment.App">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Application resource dictionary -->
      
      <!-- Colors -->
      <Color x:Key="Primary">#0056B3</Color>
      <Color x:Key="Secondary">#34495E</Color>
      <Color x:Key="Accent">#FF9800</Color>
      <Color x:Key="LightBackground">#F9F9F9</Color>
      <Color x:Key="OfflineBackground">#FFF9E6</Color>
      <Color x:Key="DataEntryBackground">#F0F7FF</Color>
      <Color x:Key="ErrorColor">#CC0000</Color>
      
      <!-- Styles -->
      <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="16" />
      </Style>
      
      <Style TargetType="Frame">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HasShadow" Value="True" />
      </Style>
      
      <Style TargetType="Entry">
        <Setter Property="FontSize" Value="16" />
      </Style>
      
    </ResourceDictionary>
  </Application.Resources>
</Application>